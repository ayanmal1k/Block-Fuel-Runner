# ─────────────────────────────────────────────────────────────
# BLOCK FUEL: Punch and Run — Environment Configuration
# ─────────────────────────────────────────────────────────────

# Dynamic Environment ID (from https://app.dynamic.xyz)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=YOUR_DYNAMIC_ENVIRONMENT_ID

# Robinhood Chain Mainnet Network Configuration
NEXT_PUBLIC_EVM_CHAIN_ID=4663
NEXT_PUBLIC_EVM_CHAIN_NAME="Robinhood Chain"
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EVM_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_EVM_NATIVE_SYMBOL=ETH

# Firebase Project Configuration (Server-side only — from https://console.firebase.google.com)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=blockfuel-game.firebaseapp.com
FIREBASE_PROJECT_ID=blockfuel-game
FIREBASE_STORAGE_BUCKET=blockfuel-game.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Admin Panel Authentication Credentials (Server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BlockFuel#Admin$2026!SecureKey

# Game Session Security HMAC Secret (Server-side only)
GAME_SECRET_KEY=YOUR_GAME_HMAC_SECRET_KEY_CHANGE_IN_PRODUCTION
