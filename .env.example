# ─────────────────────────────────────────────────────────────
# BLOCK FUEL: Punch and Run — Environment Configuration
# ─────────────────────────────────────────────────────────────

# 1. Dynamic Environment ID (from https://app.dynamic.xyz)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=YOUR_DYNAMIC_ENVIRONMENT_ID

# 2. Robinhood Mainnet / EVM Network Configuration
NEXT_PUBLIC_EVM_CHAIN_ID=10001
NEXT_PUBLIC_EVM_CHAIN_NAME="Robinhood Mainnet"
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.robinhood-chain.com
NEXT_PUBLIC_EVM_EXPLORER_URL=https://explorer.robinhood-chain.com
NEXT_PUBLIC_EVM_NATIVE_SYMBOL=ROBIN

# 3. Project Token ($FUEL) on Robinhood Chain (ERC-20 contract address)
# Set to zero-address or empty if using native currency
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 4. Minimum Token Requirement to Play / Withdraw (Set to 0 for free/open access)
NEXT_PUBLIC_MIN_TOKEN_REQUIRED=10
MIN_TOKEN_REQUIRED=10

# 5. Firebase Configuration (from https://console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# 6. Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BlockFuel#Admin$2026!SecureKey

# 7. Treasury & Economy Defaults
NEXT_PUBLIC_COINS_PER_TOKEN=10
NEXT_PUBLIC_MIN_WITHDRAW_COINS=100
GAME_SESSION_SECRET=block_fuel_secret_session_key_2026
